OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_GUARD_MODEL=google/gemma-4-31b-it:free

ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_IDS=voice-id-1,voice-id-2,voice-id-3
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=kwach

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# or a single URL (rediss:// enables TLS), which takes precedence:
# REDIS_URL=rediss://user:password:6379

HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json
